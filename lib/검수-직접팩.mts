/* 손님이 직접 만든 AI팩을 재는 «알맹이».
 *
 * 명령줄(`검수기-직접팩.mts`)과 화면(`검수기-화면.mts`)이 **이것 하나를 같이 쓴다.**
 * 두 벌로 적으면 화면에서는 통과하고 명령줄에서는 걸리는 일이 생긴다.
 *
 * 파일 «속»을 열어 보는 부분은 다시 `검수-속보기.mts` 를 쓴다 — 판매팩 검사기와 나눠 쓰는 자리다.
 */
import { 파일보기, 화면목록안내보기, 줄수세기, type 급 } from "./검수-속보기.mjs";
import { basename } from "node:path";

export type 흠 = { 급: 급; 무엇: string; 항목: string };

/* ── 있어야 할 것 ──────────────────────────────────────────────
   직접 만든 팩은 이름 뒤에 «프로젝트 이름»이 붙는다(`IA_화면목록_내서비스.xlsx`).
   그래서 통째로 맞추지 않고 앞머리로 찾는다.
   ⚠ 이 목록의 출처는 `app/(app)/dashboard/zip-all-button.tsx` 다.
     거기를 고치면 여기도 같이 고친다 — 안 그러면 멀쩡한 팩을 「빠졌다」고 한다. */
export const 있어야 = [
  { 앞: "메뉴구조_", 끝: ".xlsx", 뭐: "메뉴구조" },
  { 앞: "IA_화면목록_", 끝: ".xlsx", 뭐: "화면목록" },
  { 앞: "기능정의서_", 끝: ".xlsx", 뭐: "기능정의서" },
  { 앞: "WBS_", 끝: ".xlsx", 뭐: "개발 일정표" },
  { 앞: "FLOW_", 끝: ".html", 뭐: "흐름도(html)" },
  { 앞: "FLOW_", 끝: ".drawio", 뭐: "흐름도(drawio)" },
  { 앞: "메뉴구조_", 끝: ".pptx", 뭐: "메뉴구조 장표" },
  { 앞: "스펙팩_", 끝: ".md", 뭐: "AI 빌드 지시서(md)" },
  { 앞: "스펙팩_", 끝: ".json", 뭐: "AI 빌드 지시서(json)" },
];

/** **고르면 들어가는 것.** 없다고 흠으로 치면 안 된다.
 *
 * ⚠ 2026-08-11 에 「디자인시스템」을 «반드시 있어야 할 것»에 넣어 뒀다가 잡았다.
 *   앱은 `withPreset` 을 고른 사람에게만 넣는다(`zip-all-button.tsx`).
 *   안 고르고 만든 «멀쩡한 팩»을 불량이라고 하고 있었다.
 *   헛경보를 내는 검사기는 없는 것만 못하다. */
export const 골랐으면 = [
  { 앞: "디자인시스템_", 끝: ".md", 뭐: "디자인 규칙", 고른표시: "프리셋" },
  { 앞: "검수시나리오_", 끝: ".xlsx", 뭐: "검수 시나리오", 고른표시: "검수" },
];

/** 없어도 흠은 아니지만, 없으면 알려는 준다. */
export const 있으면좋은것 = [
  { 앞: "사이트_내놓는_법", 끝: ".html", 뭐: "사이트 내놓는 법 안내서" },
  { 앞: "앱으로_내놓는_법", 끝: ".html", 뭐: "앱으로 내놓는 법 안내서" },
];

/** 팩 하나를 잰다. 「이름 → 내용」 만 주면 zip 이든 폴더든 상관없다. */
export async function 검수하기(파일들: Map<string, Buffer>): Promise<흠[]> {
  const 흠들: 흠[] = [];
  let 지금항목 = "";
  const 담 = (g: 급, _어디: string, 무엇: string) => 흠들.push({ 급: g, 무엇, 항목: 지금항목 });

  const 이름들 = [...파일들.keys()];
  const 찾기 = (앞: string, 끝: string) =>
    이름들.find((n) => basename(n).startsWith(앞) && n.endsWith(끝));

  지금항목 = "B1";
  for (const { 앞, 끝, 뭐 } of 있어야) {
    if (!찾기(앞, 끝)) 담("FAIL", "", `${뭐} 가 없습니다 (${앞}…${끝})`);
  }
  for (const { 앞, 끝, 뭐 } of 있으면좋은것) {
    if (!찾기(앞, 끝)) 담("WARN", "", `${뭐} 가 없습니다 — 만들 때 안 고르셨을 수 있습니다`);
  }

  /* 스펙팩을 먼저 읽어 둔다. 아래 여러 검사가 이것과 견준다. */
  const 스펙이름 = 찾기("스펙팩_", ".json");
  let spec: {
    project?: { designConcept?: string | null };
    menus?: { screens?: { pageId?: string }[] }[];
  } | null = null;
  if (스펙이름) {
    try { spec = JSON.parse(파일들.get(스펙이름)!.toString("utf8")); }
    catch { /* json 이 깨진 것은 파일보기가 말한다 */ }
  }
  const 스펙화면 = (spec?.menus ?? []).reduce((n, m) => n + (m.screens?.length ?? 0), 0);
  const 스펙메뉴 = (spec?.menus ?? []).length;

  /* 「고르면 들어가는 것」은 없다고 흠이 아니다.
     다만 «고른 흔적은 있는데 파일이 없으면» 그건 빠진 것이다. */
  지금항목 = "B10";
  for (const { 앞, 끝, 뭐, 고른표시 } of 골랐으면) {
    if (찾기(앞, 끝)) continue;
    if (고른표시 === "프리셋" && spec?.project?.designConcept) {
      담("FAIL", "", `${뭐} 가 없습니다 — 그런데 지시서에는 디자인 방향이 적혀 있습니다. **고르셨는데 빠진 것입니다. 다시 받아 보세요.**`);
    } else {
      /* 흠이 아니다. 만들 때 «고르지 않으면» 안 들어가는 것이 맞다.
         이걸 경고로 내면 무엇을 고쳐야 하는지 알 수 없다(2026-08-11 사장님 지적). */
      담("알림", "", `${뭐} 는 안 들어 있습니다 — 만들 때 «고른 사람에게만» 들어가는 것이라 정상입니다. 필요하면 만들 때 골라 주세요`);
    }
  }

  /* 파일 «이름»이 성한가 — 속보다 먼저 본다.
   *
   * ⚠ 2026-08-11 에 여기서 사고가 났다. 손님이 컨셉을 여러 줄로 적으면
   *   그 줄바꿈이 파일 이름 한가운데로 들어갔다. 윈도우는 그런 이름을 «만들지 못해서»
   *   압축을 풀면 11개 중 9개가 조용히 사라진다 — 손님 눈에는 「하나도 안 들어 있다」로 보인다.
   *   파일은 다 있고 크기도 멀쩡했다. **이름만 보면 되는 것이었는데 아무도 안 봤다.** */
  지금항목 = "B11";
  for (const 이름 of 이름들) {
    const 밑 = basename(이름);
    if (/[\u0000-\u001F\u007F]/.test(밑)) {
      담("FAIL", "", `${JSON.stringify(밑)} — 이름에 «눈에 안 보이는 글자»(줄바꿈 등)가 있습니다. 압축을 풀면 이 파일이 조용히 사라집니다`);
    }
    if (/[\\/:*?"<>|]/.test(밑)) {
      담("FAIL", "", `${밑} — 이름에 윈도우가 못 쓰는 글자가 있습니다`);
    }
    if (/[.\s]$/.test(밑.replace(/\.[^.]+$/, ""))) {
      담("WARN", "", `${밑} — 이름이 점이나 공백으로 끝납니다. 윈도우에서 말썽이 납니다`);
    }
  }

  지금항목 = "B2";
  for (const [이름, b] of 파일들) {
    if (b.length === 0) { 담("FAIL", "", `${이름} — 0바이트입니다`); continue; }
    await 파일보기("", 이름, b, 담);
    if (이름.includes("화면목록")) {
      지금항목 = "B6";
      화면목록안내보기("", 이름, b, 담);
      지금항목 = "B2";
    }
  }

  /* ── 문서끼리 «같은 수»를 말하나 ────────────────────────────
     화면이 3개든 150개든 **항목은 같다.** 다만 팩이 커질수록 여기가 어긋나기 쉽다 —
     한 문서만 다시 만들고 나머지를 안 고치면 「목록엔 144개인데 일정표는 32줄」이 된다.
     손님은 목록만 보고 세다가 화면이 모자라게 나오는 것을 나중에야 안다.

     ⚠ 시트 이름으로 고른다. 화면목록 엑셀은 시트가 둘이라(안내 + 알맹이)
       첫 시트를 세면 안내 줄 수가 나온다(2026-08-11). */
  지금항목 = "B7";
  const 견줄것: { 앞: string; 시트: string; 뭐: string; 견줌: number; 방식: "같다" | "적어도" }[] = [
    { 앞: "IA_화면목록_", 시트: "화면목록", 뭐: "화면목록", 견줌: 스펙화면, 방식: "같다" },
    { 앞: "메뉴구조_", 시트: "메뉴구조", 뭐: "메뉴구조", 견줌: 스펙화면, 방식: "같다" },
    { 앞: "WBS_", 시트: "WBS", 뭐: "개발 일정표", 견줌: 스펙화면, 방식: "같다" },
    { 앞: "기능정의서_", 시트: "기능정의서", 뭐: "기능정의서", 견줌: 스펙화면, 방식: "적어도" },
  ];
  if (스펙화면 > 0) {
    for (const { 앞, 시트, 뭐, 견줌, 방식 } of 견줄것) {
      const 이름 = 찾기(앞, ".xlsx");
      if (!이름) continue;
      const 줄 = 줄수세기(파일들.get(이름)!, 시트);
      if (줄 < 0) continue;
      if (방식 === "같다" && 줄 !== 견줌) {
        담("FAIL", "", `${뭐} 가 ${줄}줄인데 AI 빌드 지시서는 화면이 ${견줌}개입니다 — 한쪽만 다시 만든 것 같습니다`);
      }
      if (방식 === "적어도" && 줄 < 견줌) {
        담("FAIL", "", `${뭐} 가 ${줄}줄뿐입니다 — 화면이 ${견줌}개면 화면마다 요건이 하나는 있어야 합니다`);
      }
    }
    if (스펙메뉴 === 0) 담("FAIL", "", "AI 빌드 지시서에 메뉴가 하나도 없습니다");
  }

  지금항목 = "B8";
  const 흐름이름 = 찾기("FLOW_", ".html");
  if (흐름이름 && spec) {
    const 있는화면 = new Set<string>(
      (spec.menus ?? []).flatMap((m) => (m.screens ?? []).map((s) => String(s.pageId).toUpperCase())));
    const 흐름글 = 파일들.get(흐름이름)!.toString("utf8");
    const 가리킨것 = [...new Set([...흐름글.matchAll(/\b([A-Z]{2}-?\d{2,4})\b/g)].map((m) => m[1].toUpperCase()))];
    const 없는것 = 가리킨것.filter((id) => !있는화면.has(id) && !있는화면.has(id.replace("-", "")));
    if (없는것.length) {
      담("WARN", "", `흐름도가 목록에 없는 화면을 가리킵니다 — ${없는것.slice(0, 6).join(", ")}${없는것.length > 6 ? ` 외 ${없는것.length - 6}` : ""}`);
    }
  }

  return 흠들;
}

/* ── 검수항목.md 읽기 ──────────────────────────────────────────
   화면에 「무엇을 재는지」를 그대로 보여 주려고 읽는다.
   **여기서 항목을 다시 적지 않는다.** 두 벌이 되면 화면과 실제가 갈라진다. */
export type 항목 = { 번호: string; 무엇: string; 누가: string; 적용: string; 어디서: string };

export function 항목읽기(md: string): { 기본: 항목[]; 변경: 항목[] } {
  const 줄들 = md.split(/\r?\n/).filter((l) => /^\|\s*[A-E]\d/.test(l));
  const 전부: 항목[] = 줄들.map((l) => {
    const 칸 = l.split("|").slice(1, -1).map((c) => c.trim());
    return { 번호: 칸[0], 무엇: 칸[1], 누가: 칸[2], 적용: 칸[3], 어디서: 칸[4] ?? "" };
  });
  /* 「어디서 왔나」가 «—» 면 처음부터 있던 기본 규칙,
     사연이 적혀 있으면 우리가 대화하다 «바꾼» 규칙이다. */
  const 사연있나 = (a: 항목) => a.어디서 && a.어디서 !== "—";
  return { 기본: 전부.filter((a) => !사연있나(a)), 변경: 전부.filter(사연있나) };
}
