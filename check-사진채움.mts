/* 자리표에 사진이 «제대로» 깔렸는지 본다. (검수항목 F4·F5·E1)
 *
 * 왜 만드나 — 세 번 다 「조용히」 지나갔다
 *   F4 (2026-08-11) 여행 팩은 자리표 이름을 `data-cap` 에 두었는데 끼우기 도구가
 *      `title` 만 보고 있었다. **234곳이 통째로 안 채워졌는데 아무 말이 없었다.**
 *      LMS 도 같은 일을 겪었다 — 그쪽은 `aria-label` 이었다(2026-08-13).
 *      「0곳 채움」이 성공처럼 보이는 것이 이 흠의 무서운 점이다.
 *   F5 (2026-08-11) 뷰티샵 홈 히어로 다섯 칸 중 «둘이 같은 사진»이었다.
 *      나란히 놓이면 바로 가짜로 읽힌다.
 *   E1 (2026-08-13) 뷰티샵 홈 히어로가 회색 자리표 다섯 개뿐이었다.
 *      사진이 적어서가 아니다 — 여행 홈은 자리표가 42개인데 멀쩡하다.
 *      **어디가 비었느냐**가 문제다. 첫 화면 히어로가 비면 팩 전체가 죽어 보인다.
 *
 * ⚠ 「같은 사진 두 번」을 무턱대고 잡으면 거짓 경보가 쏟아진다 (2026-08-14)
 *   우리는 «일부러» 되풀이한다 — 같은 강의·같은 업체는 어디서나 같은 그림이어야
 *   진짜처럼 보이기 때문이다(짝.csv). 사장님도 「작은 프로필 사진들은 좀 중복돼도
 *   된다」고 하셨다. 그래서 **이름이 다른데 그림이 같은 것**만 잡는다.
 *
 * 쓰는 법
 *   npx tsx check-사진채움.mts 뷰티샵_디럭스
 *   npx tsx check-사진채움.mts               (팩 전부)
 */
import { existsSync, readdirSync, readFileSync } from "node:fs";
import { join } from "node:path";

const 팩방 = "판매용_템플릿/_판매팩";
const 고른팩 = process.argv[2];

/** 자리표 하나. 이름은 팩마다 다른 데 적혀 있어 다섯 군데를 다 본다. */
type 자리 = { 이름: string; 사진: string | null; 곁말: string };

function 자리읽기(글월: string): 자리[] {
  const 것들: 자리[] = [];
  for (const m of 글월.matchAll(/(<div class="ph[^"]*"[^>]*>)([\s\S]*?)<\/div>\s*([\s\S]{0,200})/g)) {
    const [, 여는, 속, 뒤] = m;
    const 이름 =
      /title="([^"]*)"/.exec(여는)?.[1] ??
      /aria-label="([^"]*)"/.exec(여는)?.[1] ??
      /data-cap="([^"]*)"/.exec(여는)?.[1] ??
      (/<span class="(?:lb|cap)">([\s\S]*?)<\/span>/.exec(속)?.[1] ?? "").replace(/<[^>]+>/g, "").trim();
    /* 사진은 우리가 끼운 것(data-예시)일 수도, 팩이 처음부터 넣어 둔 것일 수도 있다. */
    const 사진 = /<img[^>]*src="[^"]*\/([^"/]+\.(?:webp|png|jpe?g))"/.exec(속)?.[1] ?? null;
    /* 자리표 바로 뒤에 붙은 «카드 이름» — 같은 이름이면 같은 그림이 옳다. */
    const 곁말 = (/<div class="(?:nm|tt|ti|title|name)[^"]*">([^<]+)</.exec(뒤)?.[1] ?? "").trim();
    것들.push({ 이름, 사진, 곁말 });
  }
  return 것들;
}

const 팩들 = readdirSync(팩방, { withFileTypes: true })
  .filter((e) => e.isDirectory() && /_(디럭스|프리미엄)$/.test(e.name))
  .map((e) => e.name)
  .filter((n) => !고른팩 || n === 고른팩);

let 틀린팩 = 0;
console.log("자리표에 사진이 제대로 깔렸나 — 통째로 빔(F4) · 히어로 빔(E1) · 이름 다른데 같은 그림(F5)\n");

for (const 팩 of 팩들) {
  const pages = join(팩방, 팩, "완성화면", "pages");
  if (!existsSync(pages)) continue;
  const 파일들 = readdirSync(pages).filter((f) => f.endsWith(".html"));
  const 흠: string[] = [];
  let 자리합 = 0, 사진합 = 0;

  for (const f of 파일들) {
    const 것들 = 자리읽기(readFileSync(join(pages, f), "utf8"));
    자리합 += 것들.length;
    사진합 += 것들.filter((x) => x.사진).length;

    /* F5 — «나란히 붙은 한 덩어리» 안에서 같은 그림이 두 번 나오나.
       ⚠ 화면 전체로 보면 안 된다 (2026-08-14 에 그렇게 짰다가 거짓 경보가 쏟아졌다).
         「매장 대표」 자리와 그 매장 카드가 같은 그림인 것은 «옳다» — 같은 가게니까.
         같은 강의·같은 업체가 여러 화면에 같은 그림으로 나오는 것도 일부러 그런 것이다.
       진짜 흠은 2026-08-11 뷰티샵 홈처럼 **히어로 모자이크 다섯 칸 중 둘이 같은 것**이다.
       그런 덩어리는 카드 이름이 붙지 않는다 — 이름 없는 자리표가 «연달아» 나온다.
       그래서 「이름 없는 자리표가 이어지는 구간」으로 끊어서 그 안에서만 견준다. */
    let 덩어리: 자리[] = [];
    const 덩어리보기 = () => {
      const 셈 = new Map<string, number>();
      for (const x of 덩어리) if (x.사진) 셈.set(x.사진, (셈.get(x.사진) ?? 0) + 1);
      for (const [사진, n] of 셈) {
        if (n > 1) 흠.push(`F5 ${f} — 나란한 ${덩어리.length}칸짜리 묶음에서 ${사진} 가 ${n}번 나온다`);
      }
      덩어리 = [];
    };
    /* ⚠ 작은 프로필·아바타 자리는 뺀다 — 사장님이 「작은 프로필 사진들은 좀 중복되게
       써도 된다」고 정하셨다(2026-08-14). 실제로 이사 업체 둘이 같은 그림을 나눠 쓴다.
       잡으려는 것은 «큰 모자이크 칸»이 겹치는 것이다. */
    const 작은얼굴 = (x: 자리) => /프로필|아바타|얼굴/.test(x.이름);
    for (const x of 것들) {
      if (x.곁말) { 덩어리보기(); continue; }   // 카드 이름이 붙었으면 덩어리가 끊긴 것
      if (작은얼굴(x)) { 덩어리보기(); continue; }
      덩어리.push(x);
    }
    덩어리보기();

    /* E1 — 첫 화면(홈)의 «앞쪽» 자리표가 통째로 비었나.
       홈 화면 파일 이름은 팩마다 HO-01 · HO0101 꼴이다. 앞 여섯 자리만 본다 —
       히어로는 언제나 화면 맨 위에 있다. */
    if (/^HO[-0]?0?1/.test(f)) {
      const 앞쪽 = 것들.slice(0, 6);
      if (앞쪽.length >= 3 && 앞쪽.every((x) => !x.사진)) {
        흠.push(`E1 ${f} — 첫 화면 히어로가 회색 자리표 ${앞쪽.length}개뿐이다 (손님이 제일 먼저 보는 자리)`);
      }
    }
  }

  /* F4 — 자리표는 있는데 사진이 «한 개도» 없다 */
  if (자리합 > 0 && 사진합 === 0) 흠.push(`F4 자리표가 ${자리합}곳인데 사진이 «한 개도» 없다 — 이름을 못 읽고 있을 수 있다`);

  if (흠.length) {
    틀린팩 += 1;
    console.log(`  ✗ ${팩}  (자리 ${자리합} · 사진 ${사진합})`);
    for (const h of 흠.slice(0, 6)) console.log(`      ${h}`);
    if (흠.length > 6) console.log(`      … 그리고 ${흠.length - 6}건 더`);
  } else {
    console.log(`  ✓ ${팩.padEnd(18)} 자리 ${String(자리합).padStart(4)} · 사진 ${String(사진합).padStart(4)}`);
  }
}

console.log(틀린팩 ? `\n${틀린팩}개 팩에 흠이 있습니다.` : "\n사진이 다 제자리에 깔려 있습니다.");
process.exit(틀린팩 ? 1 : 0);
