# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 판매용 템플릿 산출물(상품 파일 — 코드 저장소에 커밋하지 않음)
판매용_템플릿/

# 구글 OAuth 클라이언트 시크릿 파일 — 절대 커밋되면 안 됨
client_secret_*.json

# 엑셀이 파일을 열어두는 동안 만드는 잠금 파일 — 저장할 것이 아니다
~$*

# 판매 zip은 저장소에 두지 않지만(판매용_템플릿/), 홈페이지가 산 사람에게
# 내려줄 8칸만은 예외다 — 배포에 실려야 다운로드가 된다(next.config.ts).
!packs/

# 판매팩을 만들 때 잠깐 펼치는 작업 공간. 스크립트가 언제든 다시 만든다.
# 판매용_템플릿/ 에는 파는 것만 두려고 여기로 뺐다(2026-08-04).
_작업/
